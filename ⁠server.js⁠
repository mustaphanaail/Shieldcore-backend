const express = require('express');
const cors = require('cors');

const app = express();
const PORT = process.env.PORT || 3000;

app.use(cors());
app.use(express.json());

// Health Check Endpoint
app.get('/', (req, res) => {
    res.status(200).json({
        status: 'online',
        service: 'ShieldCore Security Engine API',
        timestamp: new Date().toISOString()
    });
});

// Automated Security Audit Endpoint
app.post('/api/audit', (req, res) => {
    const { url } = req.body;

    if (!url) {
        return res.status(400).json({ error: 'Target URL is required' });
    }

    // ShieldCore Security Engine Assessment Logic
    const isHttps = url.startsWith('https://');
    const score = isHttps ? Math.floor(Math.random() * 20) + 80 : Math.floor(Math.random() * 30) + 40;
    
    const vulnerabilities = [];
    if (!isHttps) {
        vulnerabilities.push({
            severity: 'HIGH',
            type: 'Unencrypted Connection',
            description: 'Target lacks SSL/TLS encryption (HTTP).'
        });
    }

    vulnerabilities.push(
        {
            severity: 'MEDIUM',
            type: 'Missing Security Headers',
            description: 'Strict-Transport-Security (HSTS) header is missing.'
        },
        {
            severity: 'LOW',
            type: 'Information Disclosure',
            description: 'X-Powered-By header exposes server software stack.'
        }
    );

    return res.status(200).json({
        target: url,
        score: score,
        status: score > 75 ? 'SECURE' : 'ACTION_REQUIRED',
        scanned_at: new Date().toISOString(),
        vulnerabilities: vulnerabilities
    });
});

app.listen(PORT, () => {
    console.log(`ShieldCore API running on port ${PORT}`);
});
